<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Keep the application on the current LTS runtime.  The site uses only
      Razor Pages features available in .NET 8, and targeting it prevents a
      deployment from failing (and returning an empty response) when the host
      does not yet have the .NET 10 runtime installed.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
