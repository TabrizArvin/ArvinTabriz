<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="وب‌سایت رسمی آروین تبریز؛ تولید، تأمین و خدمات تخصصی تجهیزات ریلی" />
    <title>@ViewData["Title"] - آروین تبریز</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header" data-site-header>
        <div class="header__inner">
            <a class="brand" asp-page="/Index" aria-label="صفحه اصلی آروین تبریز">
                <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="brand__copy"><b>آروین تبریز</b><small>گروه صنعتی آروین</small></span>
            </a>
            <div class="header__navigation" data-site-navigation>
                @await Html.PartialAsync("_MainNavigation")
                <a class="header__contact" href="/#contact"><span>تماس با ما</span><b aria-hidden="true">↙</b></a>
            </div>
            <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-navigation" aria-label="منوی اصلی">
                <span></span><span></span><span></span>
                <b class="sr-only">باز کردن منو</b>
            </button>
        </div>
    </header>

    <main class="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__brand"><span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i></span><div><b>آروین تبریز</b><span>راهکارهای مهندسی برای حرکت فردا</span></div></div>
        <span>© @DateTime.Now.Year تمامی حقوق محفوظ است.</span>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (() => {
            const header = document.querySelector('[data-site-header]');
            const menuToggle = document.querySelector('[data-menu-toggle]');
            const navigation = document.querySelector('[data-site-navigation]');
            const submenuToggles = Array.from(navigation?.querySelectorAll('[data-submenu-toggle]') ?? []);

            if (!header) {
                return;
            }

            const syncHeader = () => {
                header.classList.toggle('is-scrolled', window.scrollY > 24);
            };

            const setSubmenuState = (toggle, isOpen) => {
                const item = toggle.closest('.nav-item--has-children');

                if (!item) {
                    return;
                }

                item.classList.toggle('is-open', isOpen);
                toggle.setAttribute('aria-expanded', String(isOpen));

                if (!isOpen) {
                    item.querySelectorAll('[data-submenu-toggle]').forEach((childToggle) => {
                        childToggle.setAttribute('aria-expanded', 'false');
                        childToggle.closest('.nav-item--has-children')?.classList.remove('is-open');
                    });
                }
            };

            const closeSubmenus = () => {
                submenuToggles.forEach((toggle) => setSubmenuState(toggle, false));
            };

            const closeMenu = () => {
                header.classList.remove('is-menu-open');
                menuToggle?.setAttribute('aria-expanded', 'false');
                closeSubmenus();
            };

            syncHeader();
            window.addEventListener('scroll', syncHeader, { passive: true });

            menuToggle?.addEventListener('click', () => {
                const isOpen = header.classList.toggle('is-menu-open');
                menuToggle.setAttribute('aria-expanded', String(isOpen));
                if (!isOpen) {
                    closeSubmenus();
                }
            });

            submenuToggles.forEach((toggle) => {
                toggle.addEventListener('click', (event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    const item = toggle.closest('.nav-item--has-children');
                    const isOpen = !item?.classList.contains('is-open');

                    if (!item) {
                        return;
                    }

                    item.parentElement?.querySelectorAll(':scope > .nav-item--has-children.is-open').forEach((openItem) => {
                        if (openItem !== item) {
                            const openToggle = openItem.querySelector(':scope > .nav-item__top [data-submenu-toggle]');
                            if (openToggle) {
                                setSubmenuState(openToggle, false);
                            }
                        }
                    });

                    setSubmenuState(toggle, isOpen);
                });
            });

            navigation?.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', (event) => {
                    const item = link.closest('.nav-item--has-children');
                    const toggle = item?.querySelector(':scope > .nav-item__top > [data-submenu-toggle]');

                    if (link.getAttribute('href') === '#' && toggle) {
                        event.preventDefault();
                        toggle.click();
                        return;
                    }

                    closeMenu();
                });
            });
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    closeMenu();
                }
            });
            window.addEventListener('resize', () => {
                if (window.innerWidth > 850) {
                    closeMenu();
                }
            });
        })();
    </script>
</body>
</html>
