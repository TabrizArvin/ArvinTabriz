<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="وب‌سایت رسمی آروین تبریز؛ تولید، تأمین و خدمات تخصصی تجهیزات ریلی" />
    <title>@ViewData["Title"] - آروین تبریز</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="header__inner">
            <a class="brand" asp-page="/Index" aria-label="صفحه اصلی آروین تبریز">
                <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="brand__copy"><b>آروین تبریز</b><small>گروه صنعتی آروین</small></span>
            </a>
            <nav class="nav" aria-label="ناوبری اصلی">
                <a class="is-active" href="/">خانه</a>
                <a href="/#about">درباره ما</a>
                <a href="/#products">محصولات</a>
                <a href="/#services">خدمات ما</a>
                <a href="/#gallery">پروژه‌ها</a>
            </nav>
            <a class="header__contact" href="/#contact"><span>تماس با ما</span><b aria-hidden="true">↙</b></a>
        </div>
    </header>

    <main class="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__brand"><span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i></span><div><b>آروین تبریز</b><span>راهکارهای مهندسی برای حرکت فردا</span></div></div>
        <span>© @DateTime.Now.Year تمامی حقوق محفوظ است.</span>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
