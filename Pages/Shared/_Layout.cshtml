<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="آروین تبریز؛ طراحی، تولید، تأمین و بازسازی تجهیزات تخصصی صنعت حمل‌ونقل ریلی." />
    <meta name="robots" content="index, follow" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="آروین تبریز" />
    <meta property="og:title" content="@ViewData["Title"] - آروین تبریز" />
    <meta property="og:description" content="آروین تبریز؛ طراحی، تولید، تأمین و بازسازی تجهیزات تخصصی صنعت حمل‌ونقل ریلی." />
    <meta name="twitter:card" content="summary" />
    <title>@ViewData["Title"] - آروین تبریز</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "Organization",
            "name": "آروین تبریز",
            "email": "mailto:info@arvintabriz.com",
            "description": "طراحی، تولید، تأمین و بازسازی تجهیزات تخصصی صنعت حمل‌ونقل ریلی."
        }
    </script>
</head>
<body>
    <header class="site-header" data-site-header>
        <div class="header__inner">
            <a class="brand" asp-page="/Index" aria-label="صفحه اصلی آروین تبریز">
                <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="brand__copy"><b>آروین تبریز</b><small>گروه صنعتی آروین</small></span>
            </a>
            <div class="header__navigation" data-site-navigation>
                @await Html.PartialAsync("_MainNavigation")
                <div class="header__mobile-actions">
                    <span aria-label="English"><svg class="language-flag" viewBox="0 0 60 40" aria-hidden="true"><path fill="#012169" d="M0 0h60v40H0z"></path><path stroke="#fff" stroke-width="8" d="M0 0l60 40M60 0L0 40"></path><path stroke="#c8102e" stroke-width="4" d="M0 0l60 40M60 0L0 40"></path><path stroke="#fff" stroke-width="13" d="M30 0v40M0 20h60"></path><path stroke="#c8102e" stroke-width="7" d="M30 0v40M0 20h60"></path></svg> English</span>
                    <a href="/#contact">تماس با ما</a>
                </div>
            </div>
            <a class="header__contact" href="/#contact"><span>تماس با ما</span><b aria-hidden="true">↙</b></a>
            <span class="header__language" aria-label="English"><svg class="language-flag" viewBox="0 0 60 40" aria-hidden="true"><path fill="#012169" d="M0 0h60v40H0z"></path><path stroke="#fff" stroke-width="8" d="M0 0l60 40M60 0L0 40"></path><path stroke="#c8102e" stroke-width="4" d="M0 0l60 40M60 0L0 40"></path><path stroke="#fff" stroke-width="13" d="M30 0v40M0 20h60"></path><path stroke="#c8102e" stroke-width="7" d="M30 0v40M0 20h60"></path></svg></span>
            <div class="header__tools" aria-label="ابزارهای سایت">
                <span class="header__socials" aria-label="شبکه‌های اجتماعی">
                    <span aria-label="اینستاگرام" title="اینستاگرام">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
                    </span>
                    <span aria-label="لینکدین" title="لینکدین">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8.5V19"></path><path d="M5 5v.1"></path><path d="M10 19v-6a3 3 0 0 1 6 0v6"></path><path d="M10 10v9"></path><path d="M16 19v-5"></path></svg>
                    </span>
                </span>
                <button class="header__search" type="button" aria-label="جست‌وجو">⌕</button>
            </div>
            <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-navigation" aria-label="منوی اصلی">
                <span></span><span></span><span></span>
                <b class="sr-only">باز کردن منو</b>
            </button>
        </div>
    </header>

    <div class="site-search" data-site-search aria-hidden="true">
        <div class="site-search__backdrop" data-search-close></div>
        <section class="site-search__panel" role="dialog" aria-modal="true" aria-labelledby="site-search-title">
            <div class="site-search__heading">
                <div>
                    <p class="eyebrow"><span></span>جست‌وجو</p>
                    <h2 id="site-search-title">چه چیزی پیدا کنیم؟</h2>
                </div>
                <button type="button" class="site-search__close" data-search-close aria-label="بستن جست‌وجو">×</button>
            </div>
            <label class="sr-only" for="site-search-input">عبارت جست‌وجو</label>
            <input id="site-search-input" class="site-search__input" type="search" placeholder="نام محصول، خدمت یا بخش موردنظر..." autocomplete="off" />
            <p class="site-search__status" data-search-status>برای شروع، عبارت موردنظر را وارد کنید.</p>
            <div class="site-search__results" data-search-results></div>
        </section>
    </div>

    <main class="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__brand"><span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i></span><div><b>آروین تبریز</b><span>راهکارهای مهندسی برای حرکت فردا</span></div></div>
        <span>© @DateTime.Now.Year تمامی حقوق محفوظ است.</span>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (() => {
            const header = document.querySelector('[data-site-header]');
            const menuToggle = document.querySelector('[data-menu-toggle]');
            const navigation = document.querySelector('[data-site-navigation]');
            const submenuToggles = Array.from(navigation?.querySelectorAll('[data-submenu-toggle]') ?? []);
            const search = document.querySelector('[data-site-search]');
            const searchInput = search?.querySelector('[data-search-input]') ?? document.querySelector('#site-search-input');
            const searchResults = search?.querySelector('[data-search-results]');
            const searchStatus = search?.querySelector('[data-search-status]');
            const searchButton = document.querySelector('.header__search');

            if (!header) {
                return;
            }

            const syncHeader = () => {
                header.classList.toggle('is-scrolled', window.scrollY > 24);
            };

            const setSubmenuState = (toggle, isOpen) => {
                const item = toggle.closest('.nav-item--has-children');

                if (!item) {
                    return;
                }

                item.classList.toggle('is-open', isOpen);
                toggle.setAttribute('aria-expanded', String(isOpen));

                if (!isOpen) {
                    item.querySelectorAll('[data-submenu-toggle]').forEach((childToggle) => {
                        childToggle.setAttribute('aria-expanded', 'false');
                        childToggle.closest('.nav-item--has-children')?.classList.remove('is-open');
                    });
                }
            };

            const closeSubmenus = () => {
                submenuToggles.forEach((toggle) => setSubmenuState(toggle, false));
            };

            const closeMenu = () => {
                header.classList.remove('is-menu-open');
                menuToggle?.setAttribute('aria-expanded', 'false');
                closeSubmenus();
            };

            const searchItems = Array.from(document.querySelectorAll('.nav a[href], main section[id] h1, main section[id] h2, main section[id] h3'))
                .map((element) => {
                    const link = element.matches('a') ? element : element.closest('section')?.querySelector('a[href]');
                    return link ? { title: element.textContent?.trim() ?? '', href: link.getAttribute('href') ?? '#' } : null;
                })
                .filter((item) => item && item.title.length > 1);

            const renderSearchResults = () => {
                if (!searchInput || !searchResults || !searchStatus) {
                    return;
                }

                const query = searchInput.value.trim().toLocaleLowerCase();
                searchResults.replaceChildren();
                if (!query) {
                    searchStatus.textContent = 'برای شروع، عبارت موردنظر را وارد کنید.';
                    return;
                }

                const matches = searchItems.filter((item) => item.title.toLocaleLowerCase().includes(query)).slice(0, 12);
                searchStatus.textContent = matches.length ? `${matches.length} نتیجه پیدا شد.` : 'نتیجه‌ای پیدا نشد.';
                matches.forEach((item) => {
                    const result = document.createElement('a');
                    result.className = 'site-search__result';
                    result.href = item.href;
                    result.textContent = item.title;
                    searchResults.append(result);
                });
            };

            const closeSearch = () => {
                search?.classList.remove('is-open');
                search?.setAttribute('aria-hidden', 'true');
            };

            const openSearch = () => {
                search?.classList.add('is-open');
                search?.setAttribute('aria-hidden', 'false');
                searchInput?.focus();
                renderSearchResults();
            };

            syncHeader();
            window.addEventListener('scroll', syncHeader, { passive: true });

            menuToggle?.addEventListener('click', () => {
                const isOpen = header.classList.toggle('is-menu-open');
                menuToggle.setAttribute('aria-expanded', String(isOpen));
                if (!isOpen) {
                    closeSubmenus();
                }
            });
            searchButton?.addEventListener('click', openSearch);
            searchInput?.addEventListener('input', renderSearchResults);
            search?.querySelectorAll('[data-search-close]').forEach((closeButton) => closeButton.addEventListener('click', closeSearch));

            submenuToggles.forEach((toggle) => {
                toggle.addEventListener('click', (event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    const item = toggle.closest('.nav-item--has-children');
                    const isOpen = !item?.classList.contains('is-open');

                    if (!item) {
                        return;
                    }

                    item.parentElement?.querySelectorAll(':scope > .nav-item--has-children.is-open').forEach((openItem) => {
                        if (openItem !== item) {
                            const openToggle = openItem.querySelector(':scope > .nav-item__top [data-submenu-toggle]');
                            if (openToggle) {
                                setSubmenuState(openToggle, false);
                            }
                        }
                    });

                    setSubmenuState(toggle, isOpen);
                });
            });

            navigation?.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', (event) => {
                    const item = link.closest('.nav-item--has-children');
                    const toggle = item?.querySelector(':scope > .nav-item__top > [data-submenu-toggle]');

                    const isMobileParentLink = window.innerWidth <= 850
                        && toggle
                        && link.closest('.nav-item__top');

                    if ((link.getAttribute('href') === '#' || isMobileParentLink) && toggle) {
                        event.preventDefault();
                        toggle.click();
                        return;
                    }

                    navigation.querySelectorAll('.nav-link.is-active, .nav-link.is-selected').forEach((selectedLink) => {
                        selectedLink.classList.remove('is-active', 'is-selected');
                    });
                    link.classList.add('is-selected');
                    closeMenu();
                });
            });
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    closeMenu();
                    closeSearch();
                }
            });
            window.addEventListener('resize', () => {
                if (window.innerWidth > 850) {
                    closeMenu();
                }
            });
        })();
    </script>
</body>
</html>
