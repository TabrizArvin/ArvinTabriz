@page
@model IndexModel
@{
    ViewData["Title"] = "خانه";
}

<section class="fullscreen-slider" aria-label="اسلایدر معرفی آروین تبریز">
    <div class="fullscreen-slider__track">
        <article class="fullscreen-slider__slide fullscreen-slider__slide--one">
            <div class="fullscreen-slider__content">
                <p class="eyebrow">ArvinTabriz.com</p>
                <h1>وب‌سایت آروین تبریز</h1>
                <p class="lead">
                    یک شروع حرفه‌ای، تمام‌صفحه و واکنش‌گرا برای معرفی خدمات و مسیر ارتباط با مشتریان.
                </p>
                <div class="hero__actions">
                    <a class="button button--primary" href="#services">مشاهده خدمات</a>
                    <a class="button button--secondary" href="#contact">تماس با ما</a>
                </div>
            </div>
        </article>
        <article class="fullscreen-slider__slide fullscreen-slider__slide--two">
            <div class="fullscreen-slider__content">
                <p class="eyebrow">همگام با گیت‌هاب</p>
                <h2>آماده برای به‌روزرسانی مداوم</h2>
                <p class="lead">
                    ساختار پروژه طوری آماده شده که تغییرات پس از کامیت و انتشار، به‌سادگی روی نسخه محلی یا سرور شما همگام شود.
                </p>
            </div>
        </article>
        <article class="fullscreen-slider__slide fullscreen-slider__slide--three">
            <div class="fullscreen-slider__content">
                <p class="eyebrow">تجربه مدرن</p>
                <h2>نمایش زیبا در موبایل و دسکتاپ</h2>
                <p class="lead">
                    اسلایدر بالای صفحه با تصویرسازی گرادیانی، متن فارسی خوانا و حرکت خودکار نمایش داده می‌شود.
                </p>
            </div>
        </article>
    </div>
    <div class="fullscreen-slider__dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
    </div>
</section>

<section id="services" class="section">
    <div class="section__header">
        <p class="eyebrow">خدمات</p>
        <h2>آنچه می‌توانید توسعه دهید</h2>
    </div>
    <div class="cards">
        <article class="card">
            <h3>طراحی مدرن</h3>
            <p>رابط کاربری ساده، خوانا و مناسب نمایش در موبایل، تبلت و دسکتاپ.</p>
        </article>
        <article class="card">
            <h3>معماری قابل توسعه</h3>
            <p>پایه‌ای سبک با Razor Pages که به‌سادگی برای امکانات بعدی گسترش پیدا می‌کند.</p>
        </article>
        <article class="card">
            <h3>آماده برای محتوا</h3>
            <p>بخش‌های اولیه برای معرفی خدمات، مزیت‌ها و راه‌های ارتباطی آماده شده‌اند.</p>
        </article>
    </div>
</section>

<section id="contact" class="section contact-panel">
    <div>
        <p class="eyebrow">شروع همکاری</p>
        <h2>برای نسخه بعدی آماده‌ایم</h2>
        <p>می‌توانید امکاناتی مثل فرم تماس، پنل مدیریت، وبلاگ یا اتصال به دیتابیس را به این ساختار اضافه کنید.</p>
    </div>
    <a class="button button--primary" href="mailto:info@example.com">ارسال ایمیل</a>
</section>
