@page
@model IndexModel
@{
    ViewData["Title"] = "خانه";
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero__image" role="img" aria-label="واگن باری در مسیر ریلی"></div>
    <div class="hero__shade"></div>
    <div class="hero__line" aria-hidden="true"></div>
    <div class="hero__content">
        <p class="eyebrow eyebrow--light"><span></span>گروه صنعتی آروین تبریز</p>
        <h1 id="hero-title">حرکت رو به جلو<br />با <em>تجربه و دقت</em></h1>
        <p class="hero__lead">طراحی، تولید و بازسازی تجهیزات تخصصی صنعت ریلی؛ همراهی مطمئن برای ناوگانی ایمن و پایدار.</p>
        <div class="hero__actions"><a class="button button--warm" href="#products">مشاهده محصولات <span>↙</span></a><a class="button button--outline" href="#about">بیشتر درباره ما</a></div>
    </div>
    <div class="hero__bottom"><span>SCROLL TO EXPLORE</span><i></i><b>۰۱</b><small>/ ۰۳</small></div>
    <div class="hero__stamp" aria-hidden="true"><span>EST.</span><b>۱۳۷۲</b><span>INDUSTRIAL<br />GROUP</span></div>
</section>

<section id="about" class="intro section">
    <div class="intro__heading"><p class="eyebrow"><span></span>درباره آروین</p><h2>راهکارهای مهندسی،<br /><em>برای صنعت ریلی ایران</em></h2></div>
    <div class="intro__text"><p>ما در آروین تبریز با تکیه بر تجربه تولیدی، دانش مهندسی و شبکه‌ای پویا از تأمین‌کنندگان، پاسخ‌گوی نیازهای تخصصی صنعت حمل‌ونقل ریلی هستیم.</p><a class="text-link" href="#contact">داستان ما را بشناسید <span>↙</span></a></div>
</section>

<section class="numbers" aria-label="آمار آروین تبریز">
    <div><strong>+۳۰</strong><span>سال تجربه صنعتی</span></div><div><strong>+۴۰۰۰</strong><span>مجموعه بوژی تولید شده</span></div><div><strong>۳۶۰°</strong><span>خدمات یکپارچه ریلی</span></div><div><strong>۲۴/۷</strong><span>پاسخ‌گویی به مشتریان</span></div>
</section>

<section id="products" class="products section">
    <div class="section-heading"><div><p class="eyebrow"><span></span>توانمندی‌ها</p><h2>محصولات و<br /><em>تجهیزات تخصصی</em></h2></div><a class="circle-link" href="#contact" aria-label="مشاهده همه محصولات">↙</a></div>
    <div class="product-grid">
        <article class="product-card product-card--large"><div class="product-card__image"></div><div class="product-card__body"><span>۰۱ / محصولات ریلی</span><h3>بوژی واگن باری</h3><a href="#contact">مشاهده جزئیات <b>↙</b></a></div></article>
        <article class="product-card"><div class="product-card__image"></div><div class="product-card__body"><span>۰۲ / قطعات مکانیکی</span><h3>جعبه یاتاقان و متعلقات</h3><a href="#contact">مشاهده جزئیات <b>↙</b></a></div></article>
        <article class="product-card"><div class="product-card__image"></div><div class="product-card__body"><span>۰۳ / سیستم ایمنی</span><h3>مجموعه‌های ترمز</h3><a href="#contact">مشاهده جزئیات <b>↙</b></a></div></article>
    </div>
</section>

<section id="services" class="services section">
    <div class="services__visual"><div><span>CREATED FOR</span><b>MOTION</b></div></div>
    <div class="services__content"><p class="eyebrow eyebrow--light"><span></span>خدمات ما</p><h2>در کنار شما،<br /><em>از ایده تا حرکت</em></h2><p>از مشاوره فنی و تأمین قطعات تا تعمیرات و بازسازی، تیم آروین در تمام مراحل پروژه همراه شماست.</p><div class="service-list"><a href="#contact"><b>۰۱</b><span>تعمیرات و بازسازی</span><i>↙</i></a><a href="#contact"><b>۰۲</b><span>تأمین و ساخت قطعات</span><i>↙</i></a><a href="#contact"><b>۰۳</b><span>لیزینگ واگن باری</span><i>↙</i></a></div></div>
</section>

<section id="gallery" class="projects section"><div class="section-heading"><div><p class="eyebrow"><span></span>پروژه‌ها و کیفیت</p><h2>آنچه با هم<br /><em>به حرکت درآوردیم</em></h2></div><p>کیفیت، دقت و تعهد به زمان‌بندی، پایه‌های هر همکاری موفق در آروین تبریز هستند.</p></div><div class="project-grid"><div class="project project--one"><span>پروژه‌های تولیدی</span></div><div class="project project--two"><span>بازسازی تخصصی</span></div><div class="project project--three"><span>تأمین تجهیزات</span></div></div></section>

<section id="contact" class="contact"><p class="eyebrow eyebrow--light"><span></span>آغاز یک همکاری</p><h2>برای پروژه بعدی‌تان<br />کنارتان <em>هستیم.</em></h2><a class="button button--warm" href="mailto:info@arvintabriz.com">شروع گفت‌وگو <span>↙</span></a><a class="contact__mail" href="mailto:info@arvintabriz.com">info@arvintabriz.com</a></section>
