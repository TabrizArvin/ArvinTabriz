# Build and NuGet restore outputs
#
# These files are regenerated by `dotnet restore`/`dotnet build`. Keeping them
# out of the working tree makes it safe to remove a stale restore state when a
# build is interrupted or when two restore processes collide.
bin/
obj/

# User-specific IDE settings
.vs/
*.user
*.suo

App_Data/contact-messages.json
App_Data/*.db
App_Data/*.db-shm
App_Data/*.db-wal
